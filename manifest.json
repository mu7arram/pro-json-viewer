{
  "manifest_version": 3,
  "name": "Pro JSON Viewer",
  "version": "1.0.0",
  "description": "High-performance, virtualized JSON viewer with search, JSONPath, smart decoders, and diff mode.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": ["theme.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
